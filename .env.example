# Banco principal, consultado pelo MAICON IA em modo somente leitura.
SQL_SERVER=
SQL_PORT=1433
SQL_INSTANCE=
SQL_DATABASE=
SQL_USER=
SQL_PASSWORD=
SQL_ENCRYPT=true
SQL_TRUST_CERT=true
OPENROUTER_API_KEY=
GOOGLE_MODEL=gemini-3.5-flash-lite
GOOGLE_LIMITE_DIA=1500
VITE_GOOGLE_CLIENT_ID=
MAICON_ADMINS=
MAICON_SESSION_SECRET=
MAICON_DATA_DIR=
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4:31b
# Destino do portal HeadCargo Web e do bot.
HC_AMBIENTE=producao
# Perfil de controles nativos, validado em sessão Windows dedicada (somente homologação).
HC_CRIACAO_PERFIL=
HC_EXECUTAVEL=
HC_HOMOLOG_DIRETORIO=
HC_HOMOLOG_SQL_SERVER=
HC_HOMOLOG_SQL_DATABASE=
HC_HOMOLOG_SQL_INSTANCE=
HC_HOMOLOG_SQL_PORT=1433
HC_HOMOLOG_SQL_USER=
HC_HOMOLOG_SQL_PASSWORD=

# Ponte local: agentes explícitos, um por sessão Windows dedicada.
# Nunca colocar senhas de usuários HeadCargo nesta configuração.
HC_PONTE_AGENTES=[]
HC_PONTE_ORIGENS=https://localhost:5173,https://maicon.conlinebr.com.br:5173
# Variáveis abaixo são definidas no ambiente de CADA agente, não no navegador.
HC_PONTE_GATEWAY=https://maicon.conlinebr.com.br:5173
HC_PONTE_AGENTE_ID=
HC_PONTE_AGENTE_TOKEN=
HC_PONTE_PERFIL=
